# Sovereign Server Environment Configuration
NODE_ENV=production
PORT=8443

# PostgreSQL
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=sovereign_db

# Redis
REDIS_PASSWORD=your_secure_redis_password_here

# MinIO / S3
MINIO_ROOT_USER=sovereign_admin
MINIO_ROOT_PASSWORD=your_secure_minio_secret_here

# Cryptography & JWT
JWT_SECRET=generate_with_openssl_rand_hex_32
E2EE_KEY_DIRECTORY_ENABLED=true
